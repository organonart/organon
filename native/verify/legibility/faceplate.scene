# The look the legibility gate scores (PBR text T13, organon#217) — `faceplate`, set
# through the `organon` CLI, plus the three departures the gate itself needs.
#
# Read by `verify.sh --legibility` with the same rules as `verify/scenes/*.scene`: one
# `organon` command per line, `#` comments and blank lines ignored, shell-style quoting.
# There are no `#!` directives here — this is not a golden scene; the judge is
# `legibility-gate` against `thresholds.toml`, and the fixture is
# `organon-render/tests/fixtures/omarchy-logo.txt` (or the one `--text` names) with its
# colours taken from the ring.
#
# ⚠️ THIS IS A COPY OF THE PRESET, NOT THE PRESET. `preset.rs::builtin_text_presets()` is
# the authority for `faceplate`; the harness runs the visual with no writer, so a preset
# cannot be recalled, and this file restates the rung's look id by id. Until W19 nine of
# its fields were off the vocabulary (`atmos_enabled`, `bg_visible`, `fx_enabled`,
# `hal_amount`, `ml_enabled`, `ml_intensity`, `ml_radius`, `ml_count`, `ml_restir`) and
# the gate scored the faceplate TILES under the faceplate RIG with the atmosphere sky
# behind the grid, no halation and no pools; they are on it now, so the gate's own render
# is the dark room the preset draws. When `faceplate` changes in `preset.rs`, change it
# here in the same commit — nothing pins the two together.
#
# The three departures, deliberate:
#   glyph_cam_tilt 0   — the preset tilts 6°; the gate's grid geometry is axis-aligned
#                        (`GridGeom` has no homography), so the gate render is straight on.
#   glyph_margin 0     — the rig fits the backplane's bounds to the frame, margin included;
#                        with no margin the GRID fills the frame along one axis, which is
#                        the case `fit` handles and the case `auto` refines from.
#   rot_mod_* 0 etc.   — the clock, frozen the way every golden scene freezes it; the held
#                        camera bypasses the orbit, but a moving generator field behind a
#                        ring that goes silent would still be a moving picture.

generator "organic math"
surface original
material clearcoat

set rot_mod_x 0 rot_mod_y 0 rot_mod_z 0
set rot_amp_x 0 rot_amp_y 0 rot_amp_z 0
set trans_amp_x 0 trans_amp_y 0 trans_amp_z 0
set scale_amp 0
set cam_path 0 cam_speed 0 cam_kick 0

# The tiles (T3): bevel and crown, over the near-black dielectric under a thin coat, and
# (T9) the phosphor's falloff toward the tile edge with every dark cell a low glass tile.
set glyph_bevel 0.12 glyph_crown 0.35
set glyph_profile 0.5 glyph_dark_tiles 1
set metallic 0 roughness 0.22

# The held, fitted camera — straight on for the gate (the preset says 6).
set glyph_cam_hold 1 glyph_cam_tilt 0 glyph_cam_zoom 1
set glyph_margin 0

# The room (W19): no atmosphere sky, no backdrop, the IBL dimmed to a faint sheen — a
# near-black room with the words on it.
set atmos_enabled 0 bg_visible 0 env_intensity 0.15

# The finishing: halation in the FX pass, and (T10) the glyphs as the brightest-64 point
# lights, radius two column widths, brightest-N rather than ReSTIR on a held frame.
set fx_enabled 1 hal_amount 0.35
set ml_enabled 1 ml_intensity 1 ml_radius 2 ml_count 64 ml_restir 0

# The rig (T10): a key from low on the right, a faint fill.
set key_intensity 1.6 fill_intensity 0.25 elevation 15 azimuth 70
