# Same frozen geometry as 01, Chrome material. Isolates cube.wgsl's Chrome branch —
# the sharp prefiltered-env mirror plus Fresnel — so a regression here points at the
# material branch or at the IBL prefilter chain, not at geometry.
#!desc     Frozen cube-of-cubes, Chrome — the prefiltered-env mirror branch.
#!checks   nonblack,golden
#!tolerance 0.004

generator "organic math"
surface original
material chrome

set rot_mod_x 0 rot_mod_y 0 rot_mod_z 0
set rot_amp_x 0 rot_amp_y 0 rot_amp_z 0
set trans_amp_x 0 trans_amp_y 0 trans_amp_z 0
set scale_amp 0
set cam_path 0 cam_speed 0 cam_kick 0

set exposure 0 metallic 1.0 roughness 0.1
set ambient 0.3 glow 0.0 bloom_intensity 0.2
set env_intensity 1.0 env_rotation 0
