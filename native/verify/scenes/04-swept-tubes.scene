# Surface-mode coverage: Swept Tubes swaps the instanced mesh from the cube to the
# unit cylinder and bridges each node to its successor with an oriented, stretched rod
# (math.rs::push_rod). A regression here is in draw_tissue or the mesh swap — a class
# of bug the byte-layout goldens in param_table.rs cannot see at all.
#!desc     Frozen strands, Swept Tubes — the cylinder mesh + rod bridging path.
#!checks   nonblack,golden
#!tolerance 0.005

generator "organic math"
surface "swept tubes"
material standard

set rot_mod_x 0 rot_mod_y 0 rot_mod_z 0
set rot_amp_x 0 rot_amp_y 0 rot_amp_z 0
set trans_amp_x 0 trans_amp_y 0 trans_amp_z 0
set scale_amp 0
set cam_path 0 cam_speed 0 cam_kick 0

# A q-strand gives the rods something to bridge along; without it the tubes have no
# successor to reach for and the scene degenerates to the cube grid.
set loop_count_q 24 loop_count_x 3 loop_count_y 3 loop_count_z 3

set exposure 0 metallic 0.3 roughness 0.4
set ambient 0.3 glow 0.2 bloom_intensity 0.2
